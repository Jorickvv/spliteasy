<div class="group-page">
  <div class="container">
    <div class="group-form-wrapper">
      <div class="group-form-card">
        <p class="group-eyebrow">JOIN A GROUP</p>

        <h1>Join your roommates</h1>

        <p class="group-description">
          Enter the invite code shared by your roommate.
        </p>

        <% if flash.now[:alert] || flash[:alert] %>
          <div class="group-errors">
            <p><%= flash.now[:alert] || flash[:alert] %></p>
          </div>
        <% end %>

        <%= form_with url: join_group_path, method: :post, local: true do |form| %>
          <div class="group-field">
            <%= form.label :invite_code, "Invite code" %>

            <%= form.text_field :invite_code,
                  placeholder: "e.g. A7K2PX",
                  autofocus: true,
                  maxlength: 6 %>
          </div>

          <%= form.submit "Join group",
                class: "group-primary-button" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
