<div class="group-page">
  <div class="container">
    <div class="group-form-wrapper">

      <div class="group-form-card">

        <p class="group-eyebrow">YOUR GROUP</p>

        <h1>Edit your group</h1>

        <p class="group-description">
          Update your group name whenever you need.
        </p>

        <%= form_with model: @group, local: true do |form| %>

          <% if @group.errors.any? %>
            <div class="group-errors">
              <% @group.errors.full_messages.each do |message| %>
                <p><%= message %></p>
              <% end %>
            </div>
          <% end %>

          <div class="group-field">
            <%= form.label :name, "Group name" %>

            <%= form.text_field :name,
                  autofocus: true %>
          </div>

          <div class="group-form-actions">

            <%= form.submit "Save changes",
                  class: "group-primary-button" %>

            <%= link_to "Cancel",
                  @group,
                  class: "group-secondary-button" %>

          </div>

        <% end %>

      </div>

    </div>
  </div>
</div>
