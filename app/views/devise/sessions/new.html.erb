<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <p class="auth-eyebrow">WELCOME BACK</p>

      <h1>Log in to SplitEasy</h1>

      <p>
        Keep track of your shared expenses with your roommates.
      </p>
    </div>

    <%= simple_form_for(
          resource,
          as: resource_name,
          url: session_path(resource_name)
        ) do |f| %>

      <div class="auth-form">
        <%= f.input :email,
              label: "Email",
              required: false,
              autofocus: true,
              input_html: {
                autocomplete: "email",
                class: "auth-input"
              } %>

        <%= f.input :password,
              label: "Password",
              required: false,
              input_html: {
                autocomplete: "current-password",
                class: "auth-input"
              } %>

        <% if devise_mapping.rememberable? %>
          <%= f.input :remember_me,
                as: :boolean,
                label: "Remember me" %>
        <% end %>
      </div>

      <div class="auth-actions">
        <%= f.button :submit, "Log in", class: "auth-primary-button" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
