<div class="group-page">
  <div class="container">
    <div class="group-form-wrapper">
      <div class="group-form-card">

        <p class="group-eyebrow">NEW EXPENSE</p>

        <h1>Add an expense</h1>

        <p class="group-description">
          Add something you paid for and SplitEasy will split it equally
          between everyone in the group.
        </p>

        <%= form_with model: [@group, @expense], local: true do |form| %>

          <% if @expense.errors.any? %>
            <div class="group-errors">
              <% @expense.errors.full_messages.each do |message| %>
                <p><%= message %></p>
              <% end %>
            </div>
          <% end %>

          <div class="group-field">
            <%= form.label :description, "What did you pay for?" %>

            <%= form.text_field :description,
                  placeholder: "e.g. Groceries",
                  autofocus: true %>
          </div>

          <div class="group-field">
            <%= form.label :amount, "Amount (€)" %>

            <%= form.number_field :amount,
                  step: 0.01,
                  min: 0.01,
                  placeholder: "0.00" %>
          </div>

          <div class="group-field">
            <%= form.label :split_rule, "Split" %>

            <%= form.select :split_rule,
                  [["Equally between everyone", "equal"]] %>
          </div>

          <div class="group-form-actions">
            <%= form.submit "Add expense",
                  class: "group-primary-button" %>

            <%= link_to "Cancel",
                  group_path(@group),
                  class: "group-secondary-button" %>
          </div>

        <% end %>

      </div>
    </div>
  </div>
</div>
